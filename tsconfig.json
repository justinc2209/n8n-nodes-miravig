{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "resolveJsonModule": true,
    "allowJs": true
  },
  "include": ["nodes/**/*.ts", "nodes/**/*.js", "credentials/**/*.ts"]
}
